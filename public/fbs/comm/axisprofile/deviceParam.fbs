
namespace comm.axisprofile.fbtypes;


/// parameter value type
enum paramValueType: uint16
{
  NoneType   = 0,
  Unsigned16,
  Signed16,
  Unsigned32,
  Signed32,
  ByteArray,
  ErrorType = 0xFFFF
}

/// This table indicate the parameter's value
table paramValue {
  value_uint16   :  ushort = 0;
  value_int16    :  short = 0;
  value_int32    :  int = 0;
  value_uint32   :  uint = 0;
  value_byte_array:  [byte];
}


/// This table is drive boot parameter
table bootParam
{
  /// The idn name of this parameter.
  name: string;

  /// The value type of this parameter.
  type: paramValueType;

  /// The value of this parameter.
  value: paramValue;
}

root_type bootParam;
