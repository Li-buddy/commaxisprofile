      "cmakeCommandArgs": "-DCMAKE_TOOLCHAIN_FILE=${env.localToolchainPath}/win-msvc-x64.cmake",
      "buildCommandArgs": "-v install",
      "ctestCommandArgs": "",
      "variables": []
    },
    {
      "name": "Linux-Debug-x64",
      "generator": "Unix Makefiles",
      "intelliSenseMode": "linux-gcc-x64",
      "configurationType": "debug",
      "inheritEnvironments": [ "linux-x64" ],
      "cmakeExecutable": "${env.remoteCmakeExecutable}",
      "environments": [
        { "MSC_TARGET_NAME": "ubuntu24-gcc-x64" },
        { "MSC_CONFIG_TYPE": "debug" }
      ],
      "remoteMachineName": "${env.remoteMachine}",
      "remoteCMakeListsRoot": "${env.remoteRootDir}",
      "remoteBuildRoot": "${env.remoteRootDir}/private/generated/${env.vsAdaptedBuildFolderLinux}/${env.MSC_TARGET_NAME}/${configurationType}",
      "remoteInstallRoot": "${env.remoteRootDir}/public/bin/${env.MSC_TARGET_NAME}/${configurationType}",
      "remoteCopySources": true,
      "remoteCopySourcesOutputVerbosity": "Diagnostic",
      "remoteCopySourcesConcurrentCopies": "10",
      "remoteCopySourcesMethod": "rsync",
      "rsyncCommandArgs": "${env.rsyncCommand}",
      "cmakeCommandArgs": "-DCMAKE_TOOLCHAIN_FILE=${env.remoteToolchainPath}/linux-gcc-x64.cmake",
      "buildCommandArgs": "-j$(nproc) VERBOSE=1",
      "ctestCommandArgs": "",
      "remotePostbuildCommand": "make install",
      "remotePrebuildCommand": "",
      "remotePreGenerateCommand": "chmod -R 0777 ${env.remoteRootDir}/private/make/*.sh; ${env.remoteRootDir}/private/make/update_dependencies.sh; chmod -R 0777 ${env.remoteRootDir}/private/dependencies/automationframework/public/bin/*",
