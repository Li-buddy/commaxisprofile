{
  "environments": [
    {
      "remoteMachine": "127.0.0.1",
      "remoteRootDir": "/var/tmp/${projectDirName}",
      "remoteCmakeExecutable": "/snap/bin/cmake",
      "remoteToolchainPath": "$DEVTOOLS/tool_cmake/addons/modulesX/Platform",
      "localToolchainPath": "${env.DEVTOOLS}/tool_cmake/addons/modulesX/Platform",
      "vsAdaptedBuildFolderVsNinja": "msvc-Ninja",
      "vsAdaptedBuildFolderLinux": "msvc-Unix_Makefiles",
      "rsyncCommand": "-c -m --progress --stats --filter=\"merge ${workspaceRoot}/private/make/rsync_filter.txt\""
    }
  ],
  "configurations": [
    {
      "name": "_Windows-Debug-x64",
      "generator": "Ninja",
      "configurationType": "debug",
      "inheritEnvironments": [ "msvc_x64_x64" ],
      "environments": [
        { "MSC_TARGET_NAME": "win-msvc-x64" },
        { "MSC_CONFIG_TYPE": "debug" }
      ],
      "intelliSenseMode": "windows-msvc-x64",
      "buildRoot": "${workspaceRoot}\\private\\generated\\${env.vsAdaptedBuildFolderVsNinja}\\${env.MSC_TARGET_NAME}\\${configurationType}",
      "installRoot": "${workspaceRoot}\\public\\bin\\${env.MSC_TARGET_NAME}\\${configurationType}",
      "cmakeCommandArgs": "-DCMAKE_TOOLCHAIN_FILE=${env.localToolchainPath}/win-msvc-x64.cmake",
      "buildCommandArgs": "-v install",
      "ctestCommandArgs": "",
      "variables": []
    },
    {
      "name": "_Windows-Release-x64",
      "generator": "Ninja",
      "configurationType": "release",
      "inheritEnvironments": [ "msvc_x64_x64" ],
