<package>
  <!-- collect gcov data and generate a nice html from it -->
  <job id="gcovCollect">
    <script language="JScript">
    
      // -------------------------------------------------------------------------
      //! print some output
      // -------------------------------------------------------------------------
      function Print (str)
      {
        WScript.Echo (str);
      }
      
      // -------------------------------------------------------------------------
      //! print error and exit
      // -------------------------------------------------------------------------
      function FatalError (str)
      {
        Print ("Fatal error:\n" + str);
        WScript.Quit (1);
      }

String.prototype.trim = function()
{
    return this.replace(/^\s+|\s+$/g, '');
};

//! Get an array of file names in a sub folder structure
//! The function crawls the complete sub folder structure of the given folder.
//! The complete paths of all found files are put into the array.
//! @param[in]  folder     root folder to search (string)
//! @param[in]  farray     this array of file names is extended with the new found files (array)
//! @return                Returns the filled array
function GetFiles (folder, farray) 
{  
    var fc = new Enumerator (folder.files);
    for (; !fc.atEnd(); fc.moveNext())
    {
        var name = fso.GetFileName(fc.item()).toLowerCase();
        var pname = fso.GetAbsolutePathName(fc.item()).toLowerCase();    
        farray.push(pname);
    }
    
    /* do the recursion for all subfolders */
    var fs = new Enumerator (folder.SubFolders);
    for (; !fs.atEnd(); fs.moveNext())
      GetFiles(fs.item(), farray);
  
    return farray;
}

function FilterFiles(farray, regExp, flagStr)
{
  regExp = new RegExp(regExp, flagStr);
  var files = new Array();
  for (i=0; i<farray.length; ++i)
  {
    if (regExp.test(farray[i]))
    {
      files.push(farray[i]);
    }
  }
  return files;
}

function FindAndRemoveBasePath(farray)
{
  if (farray.length == 0)
  {
    return;
  }
  basePath = farray[0].path;
  var pos = basePath.lastIndexOf('\\');
  if (pos != -1)
  {
    basePath = basePath.substring(0, pos-1)
  }
  
  for (i=1; i<farray.length; ++i)
  {
    while ((basePath.length > 0) && (farray[i].path.indexOf(basePath) != 0))
    {
      basePath = basePath.substring(0, basePath.length-1);
    }
  }
  
  pos = basePath.lastIndexOf('\\');
  if (pos != -1)
  {
    basePath = basePath.substring(0, pos+1)
  }
  
  for (i=0; i<farray.length; ++i)
  {
    farray[i].shortPath = farray[i].path.substring(basePath.length);
    farray[i].shortPath = farray[i].shortPath.substring(0, farray[i].shortPath.length - 10)
    Print("Item short path " + farray[i].shortPath);
  }
}

function makeStruct(names) {
  var names = names.split(' ');
  var count = names.length;
  function constructor() {
    for (var i = 0; i < count; i++) {
      this[names[i]] = arguments[i];
    }
  }
  return constructor;
}

function LoadFile(fname)
{
  var file = fso.OpenTextFile(fname, 1);
  var text = file.ReadAll();
  file.Close();
  return text;
}
function saveToFile(fName, str)
{
  var file = fso.CreateTextFile(fName, true);
  file.Write(str);
  file.Close();
}

function ReadCoverage(farray)
{  
  for (i=0; i<farray.length; ++i)
  {
    var text = LoadFile(farray[i].path);
    
    pos = text.indexOf("<td class=\"headerItem\">Lines:</td>");
    if (pos == -1)
    {
      FatalError("Can't find Lines in file " + farray[i].path);
    }
    endPos = text.indexOf("</td>", pos + 33);
    if (endPos == -1)
    {
      FatalError("Can't find endpos in file " + farray[i].path);
    }
    startPos = text.lastIndexOf(">", endPos-1);
    if (startPos == -1)
    {
      FatalError("Can't find startPos in file " + farray[i].path);
    }
    startPos = startPos + 1;
    number = text.substring(startPos, endPos);
    farray[i].Percent = parseInt(number, 10);


    endPos = text.indexOf("</td>", endPos + 3);
    if (endPos == -1)
    {
      FatalError("Can't find endpos in file " + farray[i].path);
    }
    startPos = text.lastIndexOf(">", endPos-1);
    if (startPos == -1)
    {
      FatalError("Can't find startPos in file " + farray[i].path);
    }
    startPos = startPos + 1;
    number = text.substring(startPos, endPos);
    farray[i].LOC = parseInt(number, 10);

    endPos = text.indexOf("</td>", endPos + 3);
    if (endPos == -1)
    {
      FatalError("Can't find endpos in file " + farray[i].path);
    }
    startPos = text.lastIndexOf(">", endPos - 1);
    if (startPos == -1)
    {
      FatalError("Can't find startPos in file " + farray[i].path);
    }
    startPos = startPos + 1;
    number = text.substring(startPos, endPos);
    farray[i].Coverage = parseInt(number, 10);
  }
}

function WriteHTML(farray, fname)
{
  var baseHTML = LoadFile("templates/gcov_body.html");
  var singleEntry = LoadFile("templates/gcov_single.html");


  var entries = "";

  for (i=0; i<farray.length; ++i)
  {
    entry = singleEntry;
    entry = entry.replace(/%SHORTPATH%/g, farray[i].shortPath);
    entry = entry.replace(/%COVERAGE%/g, farray[i].Coverage);
    entry = entry.replace(/%LOC%/g, farray[i].LOC);
    entry = entry.replace(/%UNCOVERAGE%/g, farray[i].LOC - farray[i].Coverage);
    
    coverage = farray[i].Coverage / farray[i].LOC * 100.0;
    entry = entry.replace(/%COV_PERC%/g, coverage.toFixed(1));
    entry = entry.replace(/%COV_PERC_INV%/g, (100.0 - coverage).toFixed(1));
    
    if (coverage < 80)
    {
      entry = entry.replace(/%COLOR%/g, "ruby.png");
      entry = entry.replace(/%COV_TYPE%/g, "Lo");
    }
    else
    if (coverage < 90)
    {
      entry = entry.replace(/%COLOR%/g, "amber.png");
      entry = entry.replace(/%COV_TYPE%/g, "Med");
    }
    else
    {
      entry = entry.replace(/%COLOR%/g, "emerald.png");
      entry = entry.replace(/%COV_TYPE%/g, "Hi");
    }
    
    entries += entry;
  }

  baseHTML = baseHTML.replace("%ALLENTRIES%", entries);
  file = fso.OpenTextFile(fname, 2, true);
  file.Write(baseHTML);
  file.Close();
}

function isExcluded(item, exclude)
{
  for (n=0; n<exclude.length; ++n)
  {
    if (exclude[n].path == item.shortPath.substring(item.shortPath.length - exclude[n].path.length))
    {
      coverage = item.Coverage / item.LOC * 100.0;
      Print("Found in excludeFile " + item.shortPath);

      if (exclude[n].Coverage <= coverage)
      {
        Print("...exclude file (min cov = " + exclude[n].Coverage + "%, found cov " + coverage.toFixed(1) + "%)");
        return true;
      }
      else
      {
        Print("...do not exclude file (min cov = " + exclude[n].Coverage + "%, found cov " + coverage.toFixed(1) + "%)");
        return false;
      }
    }
  }
  return false;
}

function FilterFails(farray, exclude)
{
  var filtered = new Array();
  for (i=0; i<farray.length; ++i)
  {
    coverage = farray[i].Coverage / farray[i].LOC * 100.0;
    if (coverage >= 90.0)
    {
      farray[i].writeOut = "coverage good (" + coverage.toFixed(1) + "%)";
    }
    else
    {
      if (farray[i].LOC <= 2)
      {
        farray[i].writeOut = "coverage not good (" + coverage.toFixed(1) + "%), but low LOC (" + farray[i].LOC + ")";
      }
      else
      {
        if (isExcluded(farray[i], exclude))
        {
          farray[i].writeOut = "coverage too low (" + coverage.toFixed(1) + "%), but is excluded";
        }
        else
        {
          farray[i].writeOut = "coverage too low (" + coverage.toFixed(1) + "%)";
          filtered.push(farray[i]);
        }
      }
    }
  }
  return filtered;
}

function getCurrentTime()
{
  var currentdate = new Date(); 
  var datetime = currentdate.getDate() + "."
              + (currentdate.getMonth()+1)  + "." 
              + currentdate.getFullYear() + " @ "  
              + currentdate.getHours() + ":"  
              + currentdate.getMinutes() + ":" 
              + currentdate.getSeconds();
  return datetime;
}

function getLogTexts(data)
{
  var str = "";
  for (i=0; i<data.length; ++i)
  {
    str += "\nFile: " + data[i].shortPath + " -&gt; " + data[i].writeOut;
  }
  return str;
}

function WriteJUnit(outputFile, data, dataFiltered)
{
  var str = LoadFile("templates/junit.xml");
  str = str.replace("TESTSUITE", "linux");
  str = str.replace("CLASSNAME", "linux.Coverage");
  str = str.replace("TESTNAME", "linux.Coverage.TestCoverage");
  str = str.replace("TIME_STAMP", getCurrentTime());
  str = str.replace("TIME_TEXT", "Taken time: 1");
  str = str.replace("TIME_TEXT", "Taken time: 1");
  var errorCnt = dataFiltered.length;
  str = str.replace("NUMBER_OF_ERRORS", errorCnt);
  if (errorCnt > 0)
  {
    str = str.replace("SYSTEM_OUT", "\nTestLog:\n---------\n" + getLogTexts(data));
    str = str.replace("ERROR_TEXT", "\n\t<error message=\"" + getLogTexts(dataFiltered)+ "\"/>");
  }
  else
  {
    str = str.replace("SYSTEM_OUT", getLogTexts(data) + "\n\nNo errors found...");
    str = str.replace("ERROR_TEXT", "");
  }
  saveToFile(outputFile, str);
}
      
function ReadExclude(excludeFile)
{
  var exclude = new Array();
  if (excludeFile == "")
  {
    return exclude;
  }

  Print("Read exclude file " + excludeFile);
  var Item = makeStruct("path Coverage");
  
  var str = LoadFile(excludeFile);
  var lines = str.split('\n');
  for (i=0; i<lines.length; ++i)
  {
    var s = lines[i].trim();
    if ((s != "") && (s.charAt(0) != "#"))
    {
      var data = s.split(':');
      if ((data.length == 0) || (data.length > 2))
      {
        FatalError("Invalid format in file " + excludeFile + " at line " + (i+1) + ": " + s);
      }
      var cov = 0;
      if (data.length == 2)
      {
        cov = data[1].trim();
      }
      var add = new Item(data[0].trim(), cov);
      exclude.push(add);
    }
  }  
  Print("Found " + exclude.length + " valid entries");
  return exclude;
}

      function doWork()
      {
      
        var inputFolder = WScript.arguments(0);
        var outputFile = WScript.arguments(1);
        var outputFile2 = WScript.arguments(2);
        var excludeFile = "";
        if (WScript.arguments.length > 3)
        {
          excludeFile = WScript.arguments(3);
        }
        fso = new ActiveXObject ("Scripting.FileSystemObject");

        Print("Scanning files in folder " + inputFolder);
        var root = fso.GetFolder(inputFolder);
        var files = new Array();
        GetFiles(root, files);
        files = FilterFiles(files, "\.gcov\.html$", "")
        var Item = makeStruct("path shortPath LOC Coverage writeOut");
        var data = new Array();
        for (i=0; i<files.length; ++i)
        {
          var add = new Item(files[i], files[i], 0, 0);
          data.push(add);
        }
        FindAndRemoveBasePath(data);

        Print("Read all coverage files");
        ReadCoverage(data);

        Print("Write HTML output");
        data.sort(function (a, b) { ac = (a.Coverage - a.LOC); bc = (b.Coverage - b.LOC); if (ac==bc) return a.LOC-b.LOC; else return ac-bc; } );
        WriteHTML(data, outputFile);

        var exclude = ReadExclude(excludeFile);

        Print("Write JUnit output");
        data.sort(function (a, b) { if (a.path < b.path) return -1; else return 1; } );
        var dataFiltered = FilterFails(data, exclude);
        WriteJUnit(outputFile2, data, dataFiltered);
      }
      
      doWork();
    </script>
  </job>
</package>
